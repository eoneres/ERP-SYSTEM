# UUID real do tenant demo — obtido via: SELECT id FROM tenants WHERE slug = 'demo-tenant';
# Alternativa: usar o slug diretamente (ex: demo-tenant) — o backend resolve automaticamente
NEXT_PUBLIC_DEMO_TENANT_ID=demo-tenant

# URL interna usada APENAS pelo servidor Next.js para proxy (nunca exposta ao browser)
# NÃO adicionar NEXT_PUBLIC_API_URL aqui — causaria CORS no Codespaces
BACKEND_INTERNAL_URL=http://localhost:3001
